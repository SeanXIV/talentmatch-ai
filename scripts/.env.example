# TalentMatch AI - local database settings used by scripts/start_db.sh
# AND the Python ETL (scripts/etl). Copy to scripts/.env and adjust; do not
# commit scripts/.env. Process environment variables override this file.
#
# NOTE: DB_NAME / DB_USER / DB_PASSWORD (POSTGRES_* in the container) only
# apply on the FIRST initialization of the data volume. To reset:
#   docker rm -f talentmatch-postgres && docker volume rm talentmatch-pgdata
#
# Use DB_PORT=5433 if 5432 is already taken (e.g. by Windows PostgreSQL).

DB_CONTAINER=talentmatch-postgres
DB_VOLUME=talentmatch-pgdata
DB_NETWORK=talentmatch-net
# DB_HOST is used by the ETL only (start_db.sh ignores it).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talentmatch
DB_USER=talentmatch
# Local development only - never use this password elsewhere.
DB_PASSWORD=talentmatch
PG_IMAGE=postgres:16
FLYWAY_IMAGE=flyway/flyway:10
DB_READY_TIMEOUT=60
